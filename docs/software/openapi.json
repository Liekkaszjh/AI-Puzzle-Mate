  "components": {
    "schemas": {
      "FinalAnswer": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 1500,
            "minLength": 1,
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text"
        ],
        "title": "FinalAnswer"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NewGame": {
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "existing",
              "new"
            ],
            "title": "Source",
            "default": "existing"
          },
          "play_mode": {
            "type": "string",
            "enum": [
              "solo",
              "coop"
            ],
            "title": "Play Mode",
            "default": "coop"
          },
          "teammate_count": {
            "type": "integer",
            "maximum": 3.0,
            "minimum": 1.0,
            "title": "Teammate Count",
            "default": 2
          },
          "theme": {
            "type": "string",
            "maxLength": 100,
            "title": "Theme",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "NewGame"
      },
      "Payload": {
        "properties": {},
        "additionalProperties": false,
        "type": "object",
        "title": "Payload"
      },
      "Profile": {
        "properties": {
          "display_name": {
            "type": "string",
            "maxLength": 30,
            "minLength": 1,
            "title": "Display Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "display_name"
        ],
        "title": "Profile"
      },
      "Question": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text"
        ],
        "title": "Question"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
